# ==============================================================================
# n8n VPS Environment Configuration Template
# Copy this file to .env and replace with your actual secrets.
# NEVER commit .env to GitHub.
# ==============================================================================

# n8n Master Encryption Key (generate with: openssl rand -hex 16)
N8N_ENCRYPTION_KEY=replace_with_your_hex_encryption_key

# Supabase / External PostgreSQL Configuration
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=postgres
DB_POSTGRESDB_USER=postgres.your_project_id
DB_POSTGRESDB_PASSWORD=your_database_password
DB_POSTGRESDB_SSL=true
DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED=false

# S3 / Supabase Storage Configuration (for Binary Large Objects)
N8N_BINARY_DATA_MODE=s3
N8N_S3_BUCKET=your_storage_bucket_name
N8N_S3_REGION=ap-southeast-1
N8N_S3_ACCESS_KEY_ID=your_s3_access_key_id
N8N_S3_SECRET_ACCESS_KEY=your_s3_secret_access_key
N8N_S3_ENDPOINT=https://your-endpoint.storage.supabase.co/storage/v1/s3
N8N_S3_FORCE_PATH_STYLE=true

# Host & Webhook Domain Configuration
N8N_HOST=n8n.yourdomain.com
WEBHOOK_URL=https://n8n.yourdomain.com/
TZ=Asia/Bangkok
